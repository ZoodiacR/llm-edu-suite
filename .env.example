# Copy this file to .env and fill in your own values. .env is git-ignored, so it never reaches GitHub.

# LangSmith tracing (https://smith.langchain.com -> Settings -> API Keys)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=llm-edu-suite
# Only if your LangSmith account lives in the EU region:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Only needed with LLM_PROVIDER=openai (or ANTHROPIC_API_KEY with LLM_PROVIDER=anthropic)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Notebook 27 (agent harness): with ANTHROPIC_API_KEY set, its default model is anthropic/claude-haiku-5-5
# (about US$ 0.42 for the whole notebook); without it, qwen2.5:7b through Ollama (much slower).
# HARNESS_MODEL picks any litellm model id (anthropic/..., openai/..., gemini/...) or an Ollama name (qwen2.5:7b).
# HARNESS_REPS runs per task (default 3); HARNESS_WORKERS parallel runs (default 4 for API models, 1 for local ones).
# The key never reaches the agent's shell.
# HARNESS_MODEL=anthropic/claude-haiku-5-5
# HARNESS_REPS=3
# GEMINI_API_KEY=            (the free tier allows about 20 requests per day and model: too few for notebook 27)

# Models used by notebooks 07-16 (defaults shown). Switch provider with LLM_PROVIDER=openai|anthropic.
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:3b
# EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434
